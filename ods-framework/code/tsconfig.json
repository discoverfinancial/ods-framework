{
  "compilerOptions": {
    "outDir": "build/",
    "resolveJsonModule": true,
    "target": "es2021",
    "module": "commonjs",
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "plugins": [
      {
        "transform": "typia/lib/transform"
      }
    ]    
  },
  "include": ["src"],
  "exclude": ["node_modules", "**/__tests__/*"]
}
